# ==============================================================================
# BOUNDLESS TRAVEL SOCIETY — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env.local or .env for local development.
# NEVER commit real credentials, secrets, or private keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CLIENT CONFIGURATION (Public)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK — PRIMARY INSTANCE (Server-side)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK — SECONDARY INSTANCE (Election / Isolation)
# ------------------------------------------------------------------------------
FIREBASE_SECONDARY_PROJECT_ID=
FIREBASE_SECONDARY_CLIENT_EMAIL=
FIREBASE_SECONDARY_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 4. NEXTAUTH & ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASS_HASH=

# ------------------------------------------------------------------------------
# 5. BREVO TRANSACTIONAL EMAIL SERVICE
# ------------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_REPLY_TO=
EMAIL_FROM=
EMAIL_FROM_NAME=

# ------------------------------------------------------------------------------
# 6. CLOUDINARY MEDIA STORAGE
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ------------------------------------------------------------------------------
# 7. GOOGLE DRIVE STUDENT DOCUMENT UPLOAD (Apps Script Web App)
# ------------------------------------------------------------------------------
DRIVE_UPLOAD_URL=
DRIVE_UPLOAD_SECRET=

# ------------------------------------------------------------------------------
# 8. GENERAL APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_ALLOWED_RESULT_EMAILS=
NODE_ENV=development
